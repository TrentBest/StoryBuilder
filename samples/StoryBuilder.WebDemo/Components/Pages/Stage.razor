@page "/stage"
@inject StoryBuilderSession Session
@inject NarratorAgent Narrator
@inject IJSRuntime JS

<PageTitle>The Stage · StoryBuilder</PageTitle>

<div class="page-head">
    <div class="eyebrow">Door 02 · The Stage</div>
    <h1>Show us what happened.</h1>
    <p class="lede">Capture a fight or quiet conversation as small beats. Play it, narrate it, or arrange it like claymation. The tool turns recorded details into a draft without inventing missing actions.</p>
</div>

<div class="workbench-grid">
    <section class="panel stack">
        <div class="eyebrow">New scene</div>
        <h2>Set the stage</h2>
        <div class="field">
            <label for="scene-title">Scene title</label>
            <input id="scene-title" @bind="sceneTitle" placeholder="The North Gate" />
        </div>
        <div class="field">
            <label for="scene-location">Location (optional)</label>
            <input id="scene-location" @bind="sceneLocation" placeholder="A ruined gate, a kitchen, a starship..." />
        </div>
        <div class="field">
            <label for="scene-purpose">What should change in this scene? (optional)</label>
            <textarea id="scene-purpose" @bind="scenePurpose" rows="2" placeholder="Mara wants the gate opened; the guard's refusal forces her to reveal why she is really here."></textarea>
            <span class="muted">A scene becomes useful when something changes: a decision, relationship, danger, discovery, or available choice.</span>
        </div>
        <div class="field">
            <label for="capture-mode">Capture style</label>
            <select id="capture-mode" @bind="captureMode">
                <option value="Freeform">Freeform notes</option>
                <option value="Played">Played by participants</option>
                <option value="BeatByBeat">Beat by beat</option>
                <option value="PoseSequence">Pose sequence</option>
                <option value="Claymation">Claymation</option>
            </select>
        </div>
        <button @onclick="CreateScene">Create scene</button>
        <hr />
        <div class="eyebrow">Saved in this workspace</div>
        @if (Session.Workspace.Scenes.Count == 0)
        {
            <div class="empty">No scenes yet. Every scene can start as an empty room.</div>
        }
        else
        {
            <div class="list">
                @foreach (var scene in Session.Workspace.Scenes)
                {
                    <button class="list-item @(currentScene?.Id == scene.Id ? "selected" : "")" @onclick="() => SelectScene(scene)">
                        <strong>@scene.Title</strong>
                        <span class="chip">@scene.CaptureMode</span>
                        <span>@scene.Beats.Count beat(s) · @(scene.Location ?? "Location unknown")</span>
                    </button>
                }
            </div>
        }
    </section>

    <section class="panel stack">
        @if (currentScene is null)
        {
            <div class="eyebrow">Scene editor</div>
            <h2>Choose a scene</h2>
            <div class="empty">Create a scene or select one from the list. No prose is required to get started.</div>
        }
        else
        {
            <div class="row">
                <div class="grow">
                    <div class="eyebrow">@currentScene.CaptureMode · @currentScene.Status</div>
                    <h2>@currentScene.Title</h2>
                </div>
                <span class="chip">@currentScene.Beats.Count beats</span>
            </div>
            <div class="field">
                <label for="current-scene-purpose">Scene purpose / intended change</label>
                <textarea id="current-scene-purpose" @bind="scenePurpose" rows="2" placeholder="What does someone want here, what resists them, and what changes by the end?"></textarea>
                <div class="row">
                    <button class="secondary" @onclick="SaveScenePurpose">Save scene purpose</button>
                </div>
                <span class="muted">This is an authoring note, not a rule the scene must obey. It helps you judge whether the beats serve the story.</span>
            </div>
            <div class="field-grid">
                <div class="field">
                    <label for="actor">Actor / participant</label>
                    <input id="actor" @bind="actorLabel" placeholder="Mara" />
                </div>
                <div class="field">
                    <label for="beat-kind">Beat type</label>
                    <select id="beat-kind" @bind="beatKind">
                        <option value="Action">Action</option>
                        <option value="Reaction">Reaction</option>
                        <option value="Dialogue">Dialogue</option>
                        <option value="Pose">Pose / position</option>
                        <option value="Transition">Transition</option>
                        <option value="Narration">Narration note</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label for="action">Action / change</label>
                <input id="action" @bind="actionText" placeholder="ducks under the swinging arm" />
            </div>
            <div class="field">
                <label for="reaction">Reaction</label>
                <input id="reaction" @bind="reactionText" placeholder="stumbles backward" />
            </div>
            <div class="field">
                <label for="dialogue">Dialogue</label>
                <input id="dialogue" @bind="dialogueText" placeholder="Stay behind me." />
            </div>
            <div class="field">
                <label for="pose">Pose / position (claymation)</label>
                <input id="pose" @bind="poseText" placeholder="left hand on the latch, weight on the rear foot" />
            </div>
            <div class="field">
                <label for="tone">Emotional tone (optional)</label>
                <input id="tone" @bind="toneText" placeholder="afraid but determined" />
            </div>
            <div class="field">
                <label for="capture-note">Anything else to preserve</label>
                <textarea id="capture-note" @bind="captureNote" placeholder="A quick note; details can be expanded later."></textarea>
            </div>
            <button @onclick="AddBeat">Add beat to scene</button>
        }
    </section>
</div>

@if (currentScene is not null)
{
    <section class="panel stack" style="margin-top:1rem">
        <div class="row">
            <div class="grow">
                <div class="eyebrow">Storyboard</div>
                <h2>Ordered beats</h2>
            </div>
            <span class="chip">Move beats to change timing</span>
        </div>
        @if (currentScene.Beats.Count == 0)
        {
            <div class="empty">Nothing has happened yet. Add one action, line, reaction, or pose.</div>
        }
        else
        {
            <div class="list">
                @foreach (var beat in currentScene.Beats.OrderBy(b => b.Sequence))
                {
                    <div class="list-item">
                        <div class="row">
                            <span class="chip">@(beat.Sequence.ToString("00"))</span>
                            <strong>@beat.Kind</strong>
                            <span class="grow">@beat.ActorLabel</span>
                            <button class="secondary" disabled="@(beat.Sequence == 1)" @onclick="() => MoveBeat(beat.Id, -1)">↑</button>
                            <button class="secondary" disabled="@(beat.Sequence == currentScene.Beats.Count)" @onclick="() => MoveBeat(beat.Id, 1)">↓</button>
                            <button class="danger" @onclick="() => RemoveBeat(beat.Id)">Remove</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(beat.Action)) { <p>Action: @beat.Action</p> }
                        @if (!string.IsNullOrWhiteSpace(beat.Reaction)) { <p>Reaction: @beat.Reaction</p> }
                        @if (!string.IsNullOrWhiteSpace(beat.Dialogue)) { <p>Dialogue: “@beat.Dialogue”</p> }
                        @if (!string.IsNullOrWhiteSpace(beat.PoseOrPosition)) { <p>Pose: @beat.PoseOrPosition</p> }
                        @if (!string.IsNullOrWhiteSpace(beat.EmotionalTone)) { <p>Tone: @beat.EmotionalTone</p> }
                        @if (!string.IsNullOrWhiteSpace(beat.CaptureNote)) { <p class="muted">@beat.CaptureNote</p> }
                        @if (beat.EventIds.Count > 0)
                        {
                            <p class="muted">Linked events: @string.Join(" · ", beat.EventIds.Select(eventId => Session.Workspace.Events.FirstOrDefault(item => item.Id == eventId)?.Title ?? "Missing event"))</p>
                        }
                    </div>
                }
            </div>
        }
        @if (Session.Workspace.Events.Count > 0 && currentScene.Beats.Count > 0)
        {
            <hr />
            <div class="eyebrow">Timeline connections</div>
            <h3>Link a key event to a specific beat</h3>
            <div class="field-grid">
                <div class="field">
                    <label for="event-link-beat">Scene beat</label>
                    <select id="event-link-beat" @bind="selectedBeatId">
                        @foreach (var beat in currentScene.Beats.OrderBy(item => item.Sequence))
                        {
                            <option value="@beat.Id">@(beat.Sequence.ToString("00")) · @beat.Kind · @(beat.Action ?? beat.Dialogue ?? beat.ActorLabel ?? "Untitled beat")</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="event-link-event">World event</label>
                    <select id="event-link-event" @bind="selectedEventId">
                        @foreach (var storyEvent in Session.Workspace.Events)
                        {
                            <option value="@storyEvent.Id">@storyEvent.Title</option>
                        }
                    </select>
                </div>
            </div>
            <button class="secondary" @onclick="LinkEventToBeat">Link event to beat</button>
            @if (!string.IsNullOrWhiteSpace(eventLinkMessage))
            {
                <p class="muted" role="status">@eventLinkMessage</p>
            }
        }
        <hr />
        <div class="eyebrow">Narration draft</div>
        <h2>Turn the beats into words</h2>
        <p class="muted">This draft uses recorded details only. Edit the beats or copy the draft into your prose; it is not treated as final canon.</p>
        <pre class="narration">@Session.SceneComposer.ComposeNarration(currentScene)</pre>
        <button class="secondary" @onclick="CopyNarration">Copy narration draft</button>
        @if (!string.IsNullOrWhiteSpace(copyMessage))
        {
            <p class="muted">@copyMessage</p>
        }
        <hr />
        <div class="eyebrow">Narrator workbench · author review</div>
        <h2>Prepare a manuscript passage</h2>
        <p class="muted">Choose a point of view, prepare the draft, edit it, then explicitly submit it for knowledge review and save. Linked world events are checked against what the selected observer is allowed to know.</p>
        <div class="field-grid">
            <div class="field">
                <label for="narrator-observer">Point-of-view character</label>
                <select id="narrator-observer" @bind="selectedObserverId">
                    <option value="">No character selected</option>
                    @foreach (var character in Session.Workspace.Characters)
                    {
                        <option value="@character.Id">@character.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="narrator-manuscript">Manuscript</label>
                <select id="narrator-manuscript" @bind="selectedManuscriptId">
                    <option value="">Choose a manuscript</option>
                    @foreach (var manuscript in Session.Workspace.Manuscripts)
                    {
                        <option value="@manuscript.Id">@manuscript.Title</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <button class="secondary" @onclick="CreateNarrationManuscript">Create manuscript + chapter</button>
            <button class="secondary" @onclick="PrepareNarrationDraft" disabled="@(!CanPrepareNarration)">Prepare draft for review</button>
        </div>
        @if (SelectedManuscript is not null)
        {
            <div class="field">
                <label for="narrator-section">Destination section</label>
                <select id="narrator-section" @bind="selectedSectionId">
                    @foreach (var section in SelectedManuscript.Sections.OrderBy(item => item.Sequence))
                    {
                        <option value="@section.Id">@section.Title</option>
                    }
                </select>
            </div>
        }
        @if (narrationRequested)
        {
            <div class="field">
                <label for="narrator-draft">Editable narration draft</label>
                <textarea id="narrator-draft" @bind="narrationDraft" rows="10"></textarea>
                <span class="muted">This is an author-edited draft, not generated creative prose. No manuscript content changes until you submit it below.</span>
            </div>
            <button @onclick="SubmitNarrationDraft">Review claims and save passage</button>
        }
        @if (!string.IsNullOrWhiteSpace(narratorMessage))
        {
            <p class="muted" role="status">@narratorMessage</p>
        }
        @if (lastNarrationSubmission is not null)
        {
            <div class="list-item">
                <strong>@(lastNarrationSubmission.Accepted ? "Draft accepted" : "Draft held for review")</strong>
                <p>@lastNarrationSubmission.Message</p>
                @foreach (var constraint in lastNarrationSubmission.Constraints.Where(item => !item.IsAllowed))
                {
                    <p class="muted">@constraint.Explanation</p>
                }
            </div>
        }
    </section>
}

@code {
    private string sceneTitle = "Untitled scene";
    private string sceneLocation = string.Empty;
    private string scenePurpose = string.Empty;
    private string captureMode = "Freeform";
    private SceneRecord? currentScene;
    private string actorLabel = string.Empty;
    private string beatKind = "Action";
    private string actionText = string.Empty;
    private string reactionText = string.Empty;
    private string dialogueText = string.Empty;
    private string poseText = string.Empty;
    private string toneText = string.Empty;
    private string captureNote = string.Empty;
    private string copyMessage = string.Empty;
    private string selectedBeatId = string.Empty;
    private string selectedEventId = string.Empty;
    private string eventLinkMessage = string.Empty;
    private string selectedObserverId = string.Empty;
    private string selectedManuscriptId = string.Empty;
    private string selectedSectionId = string.Empty;
    private string narrationDraft = string.Empty;
    private string narratorMessage = string.Empty;
    private bool narrationRequested;
    private NarratorDraftSubmission? lastNarrationSubmission;

    private ManuscriptEdition? SelectedManuscript =>
        Guid.TryParse(selectedManuscriptId, out var manuscriptId)
            ? Session.Workspace.Manuscripts.FirstOrDefault(item => item.Id == manuscriptId)
            : null;

    private bool CanPrepareNarration =>
        SelectedManuscript is not null
        && Guid.TryParse(selectedSectionId, out var sectionId)
        && SelectedManuscript.Sections.Any(item => item.Id == sectionId);

    private SceneCaptureMode SelectedCaptureMode =>
        Enum.TryParse<SceneCaptureMode>(captureMode, out var value) ? value : SceneCaptureMode.Freeform;

    protected override void OnInitialized()
    {
        selectedEventId = Session.Workspace.Events.FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private void CreateNarrationManuscript()
    {
        var manuscript = Session.CreateManuscript("Untitled story");
        manuscript = Session.AddManuscriptSection(manuscript.Id, ManuscriptSectionKind.Chapter, "Chapter 1");
        selectedManuscriptId = manuscript.Id.ToString();
        selectedSectionId = manuscript.Sections.OrderBy(item => item.Sequence).First().Id.ToString();
        narratorMessage = "Created a manuscript and its first chapter.";
        narrationRequested = false;
    }

    private void PrepareNarrationDraft()
    {
        if (currentScene is null || !CanPrepareNarration || SelectedManuscript is null
            || !Guid.TryParse(selectedSectionId, out var sectionId))
            return;

        Guid? observerId = Guid.TryParse(selectedObserverId, out var parsedObserverId)
            ? parsedObserverId
            : null;
        Narrator.RequestDraft(SelectedManuscript.Id, sectionId, observerId);
        narrationDraft = Session.SceneComposer.ComposeNarration(currentScene);
        narrationRequested = true;
        lastNarrationSubmission = null;
        narratorMessage = observerId is null
            ? "Draft prepared. Without a point-of-view character, linked event claims will be held for review."
            : $"Draft prepared for {Session.Workspace.Characters.First(item => item.Id == observerId).Name}'s point of view. Review the text before saving.";
    }

    private void SubmitNarrationDraft()
    {
        if (currentScene is null || !narrationRequested)
            return;

        var eventIds = currentScene.Beats.SelectMany(beat => beat.EventIds).Distinct().ToArray();
        var asOfEventId = eventIds.LastOrDefault();
        lastNarrationSubmission = Narrator.SubmitDraft(
            narrationDraft,
            eventIds,
            eventIds.Length == 0 ? null : asOfEventId);
        narratorMessage = lastNarrationSubmission.Message;
        if (lastNarrationSubmission.Accepted)
            narrationRequested = false;
    }

    private void CreateScene()
    {
        currentScene = Session.CreateScene(sceneTitle, sceneLocation, SelectedCaptureMode);
        if (!string.IsNullOrWhiteSpace(scenePurpose))
            currentScene = Session.UpdateScene(currentScene with { Purpose = scenePurpose.Trim() });
        selectedBeatId = string.Empty;
        sceneTitle = "Untitled scene";
        sceneLocation = string.Empty;
        scenePurpose = string.Empty;
    }

    private void SelectScene(SceneRecord scene)
    {
        currentScene = scene;
        sceneTitle = scene.Title;
        sceneLocation = scene.Location ?? string.Empty;
        scenePurpose = scene.Purpose ?? string.Empty;
        captureMode = scene.CaptureMode.ToString();
        selectedBeatId = scene.Beats.OrderBy(beat => beat.Sequence).FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private void SaveScenePurpose()
    {
        if (currentScene is null)
            return;

        currentScene = Session.UpdateScene(currentScene with
        {
            Purpose = string.IsNullOrWhiteSpace(scenePurpose) ? null : scenePurpose.Trim(),
            UpdatedAtUtc = DateTimeOffset.UtcNow
        });
    }

    private void AddBeat()
    {
        if (currentScene is null)
            return;

        var kind = Enum.TryParse<SceneBeatKind>(beatKind, out var value) ? value : SceneBeatKind.Action;
        var beat = new SceneBeat
        {
            Kind = kind,
            ActorLabel = string.IsNullOrWhiteSpace(actorLabel) ? null : actorLabel.Trim(),
            Action = actionText.Trim(),
            Reaction = reactionText.Trim(),
            Dialogue = dialogueText.Trim(),
            PoseOrPosition = poseText.Trim(),
            EmotionalTone = toneText.Trim(),
            CaptureNote = captureNote.Trim(),
            Attribution = "Participant",
            Status = CanonStatus.Proposed
        };

        currentScene = Session.UpdateScene(currentScene.AddBeat(beat));
        selectedBeatId = beat.Id.ToString();
        actionText = string.Empty;
        reactionText = string.Empty;
        dialogueText = string.Empty;
        poseText = string.Empty;
        toneText = string.Empty;
        captureNote = string.Empty;
        copyMessage = string.Empty;
    }

    private void RemoveBeat(Guid beatId)
    {
        if (currentScene is null)
            return;

        var beats = currentScene.Beats
            .Where(beat => beat.Id != beatId)
            .OrderBy(beat => beat.Sequence)
            .Select((beat, index) => beat with { Sequence = index + 1 })
            .ToList();
        currentScene = Session.UpdateScene(currentScene with { Beats = beats, UpdatedAtUtc = DateTimeOffset.UtcNow });
        selectedBeatId = currentScene.Beats.FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private void LinkEventToBeat()
    {
        if (currentScene is null || !Guid.TryParse(selectedBeatId, out var beatId)
            || !Guid.TryParse(selectedEventId, out var eventId))
        {
            eventLinkMessage = "Choose a scene beat and world event first.";
            return;
        }

        try
        {
            currentScene = Session.LinkEventToSceneBeat(currentScene.Id, beatId, eventId);
            eventLinkMessage = "Linked the existing world event to this beat. The event itself was not duplicated.";
        }
        catch (KeyNotFoundException exception)
        {
            eventLinkMessage = exception.Message;
        }
    }

    private void MoveBeat(Guid beatId, int offset)
    {
        if (currentScene is null)
            return;

        var ids = currentScene.Beats.OrderBy(beat => beat.Sequence).Select(beat => beat.Id).ToList();
        var currentIndex = ids.IndexOf(beatId);
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ids.Count)
            return;

        (ids[currentIndex], ids[targetIndex]) = (ids[targetIndex], ids[currentIndex]);
        currentScene = Session.UpdateScene(currentScene.ReorderBeats(ids));
    }

    private async Task CopyNarration()
    {
        if (currentScene is null)
            return;

        try
        {
            await JS.InvokeVoidAsync("storyBuilderCopy", Session.SceneComposer.ComposeNarration(currentScene));
            copyMessage = "Narration draft copied to the clipboard.";
        }
        catch (JSException)
        {
            copyMessage = "Clipboard access is unavailable here. Select the narration text above and copy it manually.";
        }
    }
}
