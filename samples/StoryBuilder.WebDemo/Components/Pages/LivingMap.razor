@page "/living-map"
@implements IDisposable
@inject StoryBuilderSession Session

<PageTitle>Living Map · StoryBuilder</PageTitle>

<div class="page-head">
    <div class="eyebrow">Door 05 · Living Documentation</div>
    <h1>Let the records draw the picture.</h1>
    <p class="lede">This view is generated by GUI.SVG from the current StoryBuilderSession. Add a character, change a trait, or record a scene and the picture updates from the same workspace data.</p>
</div>

<section class="panel stack">
    <div class="row">
        <div class="grow">
            <div class="eyebrow">Semantic model → SVG manifestation</div>
            <h2>Workspace constellation</h2>
        </div>
        <span class="chip">@Session.Workspace.Characters.Count character(s)</span>
        <span class="chip">@Session.Workspace.Scenes.Count scene(s)</span>
    </div>
    <div class="living-svg" role="img" aria-label="Generated SVG view of characters, trait vocabulary, and current workspace counts">
        @((MarkupString)svgMarkup)
    </div>
    <p class="muted">The map shows a compact sample rather than trying to enumerate an unbounded universe. The source records remain authoritative; the SVG is a manifestation, not a second data store.</p>
</section>

@code {
    private readonly StoryBuilderLivingMapRenderer mapRenderer = new();
    private string svgMarkup = string.Empty;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        RefreshSvg();
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        RefreshSvg();
        StateHasChanged();
    });

    private void RefreshSvg() => svgMarkup = mapRenderer.Render(Session);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
