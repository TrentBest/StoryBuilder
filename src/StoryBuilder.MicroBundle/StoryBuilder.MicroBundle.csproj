<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Hosts with a shared GUI checkout can override this to prevent duplicate GUI.Core assembly identities. -->
    <WorkshopGuiCoreProject Condition="'$(WorkshopGuiCoreProject)' == ''">$(MSBuildThisFileDirectory)..\..\external\TheSingularityWorkshop.GUI\src\Core\TheSingularityWorkshop.GUI.Core.csproj</WorkshopGuiCoreProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP_USE_REPOSITORY_SOURCES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StoryBuilder.Core/StoryBuilder.Core.csproj" />
    <ProjectReference Include="$(WorkshopGuiCoreProject)" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <ProjectReference Include="..\..\..\TheSingularityWorkshop.MicroBundleDomain\TheSingularityWorkshop.MicroBundleDomain.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
  </ItemGroup>
</Project>
